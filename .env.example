# Backend
APP_NAME=Catalogo de Servicios API
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_PORT=8000

# PostgreSQL local
POSTGRES_DB=catalogo_servicios
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_dev
POSTGRES_PORT=5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=catalogo_servicios
DATABASE_USER=catalogo
DATABASE_PASSWORD=catalogo_dev

# Seguridad local. Generar con: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=REEMPLAZAR_CON_UNA_CLAVE_BASE64_URLSAFE_DE_32_BYTES
SESSION_EXPIRE_MINUTES=480
FRONTEND_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
# Opcionales del harness de aceptación (base y credenciales de prueba independientes):
# ACCEPTANCE_EVIDENCE_DIR=docs/evidencias/aceptacion-local
# ACCEPTANCE_API_PORT=18001
# ACCEPTANCE_FRONTEND_PORT=15174
# Solo para exportaciones sin .git; usar el commit real y declarar cambios:
# ACCEPTANCE_COMMIT=<sha-verificado-de-40-caracteres>
# ACCEPTANCE_DIRTY=true
