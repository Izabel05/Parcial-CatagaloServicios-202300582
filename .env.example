# Backend
APP_NAME=Catalogo de Servicios API
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_PORT=8000

# PostgreSQL local
POSTGRES_DB=catalogo_servicios
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_dev
POSTGRES_PORT=5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=catalogo_servicios
DATABASE_USER=catalogo
DATABASE_PASSWORD=catalogo_dev

# Seguridad local. Generar con: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=KEY_32
SESSION_EXPIRE_MINUTES=480
FRONTEND_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
